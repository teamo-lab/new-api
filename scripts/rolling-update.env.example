# Copy to scripts/rolling-update.env and fill in the CLB identifiers.
# Tencent Cloud credentials should be provided through the normal tccli
# configuration or environment; do not store secrets in this file.

CLB_REGION=na-siliconvalley
CLB_ID=lb-xxxxxxxx
CLB_LISTENER_ID=lbl-xxxxxxxx
# Required only for an HTTP/HTTPS forwarding rule; leave empty for L4 listeners.
CLB_LOCATION_ID=
CLB_TARGET_PORT=3000

# SSH target,private ENI IP. The private IP must match the CLB backend target.
NODES_CSV='root@43.153.32.67,172.26.0.31 root@43.172.117.230,172.26.0.32'

DRAIN_SECONDS=15
HEALTH_TIMEOUT_SECONDS=180
IMAGE=uswccr.ccs.tencentyun.com/floatai/newapi:1.1.4
# Set to 1 to print commands without changing CLB or servers.
DRY_RUN=0
