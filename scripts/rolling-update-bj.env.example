# Copy to scripts/rolling-update-bj.env and fill in the listener ID.
# Tencent Cloud credentials should be provided through tccli configuration or
# environment variables; do not store secrets in this file.

CLB_REGION=ap-beijing
CLB_ID=lb-k2xs6db9
CLB_LISTENER_ID=lbl-xxxxxxxx
# Required only for an HTTP/HTTPS forwarding rule; leave empty for L4 listeners.
CLB_LOCATION_ID=
CLB_TARGET_PORT=3000

# SSH target,private ENI IP. The private IP must match the CLB backend target.
NODES_CSV='root@82.157.29.200,172.21.32.13 root@49.232.247.197,172.21.32.9'

DRAIN_SECONDS=15
HEALTH_TIMEOUT_SECONDS=180
IMAGE=uswccr.ccs.tencentyun.com/floatai/newapi:latest
DRY_RUN=0
